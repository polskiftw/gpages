<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Jotunn</AssemblyName>
    <RootNamespace>Jotunn</RootNamespace>
    <Version>2.30.1</Version>
    <AssemblyVersion>2.30.1.0</AssemblyVersion>
    <FileVersion>2.30.1.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <VALHEIM_MANAGED>$(ValheimInstall)\Valheim_Data\Managed</VALHEIM_MANAGED>
    <BEPINEX_PATH>$(ValheimInstall)\BepInEx</BEPINEX_PATH>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <Import Project="JotunnLibRefsCorlib.props" />
</Project>
