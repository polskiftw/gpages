<Window x:Class="GDupe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GDupe" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="GDupe" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Exact image and video duplicates" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ChooseFolderButton" Content="Choose folder" Click="ChooseFolder_Click"/>
                <Button x:Name="RescanButton" Content="Restart scan" Click="Rescan_Click" IsEnabled="False"/>
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" Margin="0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="FolderText" Text="Choose a folder to begin" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Text="0 duplicate groups" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="330" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="GroupsList" Grid.Column="0" SelectionChanged="GroupsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Sha256}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <DataGrid x:Name="FilesGrid" Grid.Column="2" SelectionChanged="FilesGrid_SelectionChanged" MouseDoubleClick="FilesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Dimensions" Binding="{Binding DimensionsDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedLocal, StringFormat={}{0:g}}" Width="140"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"/>
                        <MediaElement x:Name="VideoPreview" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed"/>
                        <TextBlock x:Name="PreviewPlaceholder" Text="Select a file to preview" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock x:Name="PreviewName" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewDetails" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenFileButton" Content="Open file" Click="OpenFile_Click" IsEnabled="False"/>
                            <Button x:Name="OpenFolderButton" Content="Show in folder" Click="OpenFolder_Click" IsEnabled="False" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="180" Height="5" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
